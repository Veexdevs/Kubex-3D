{
  "appId": "com.veexdevs.kubex3d",
  "appName": "Kubex 3D",
  "webDir": "www",
  "bundledWebRuntime": false,
  "android": {
    "backgroundColor": "#000000",
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#000000",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    }
  }
}
