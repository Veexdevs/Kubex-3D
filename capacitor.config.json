{
  "appId": "com.veexdevs.kubex3d",
  "appName": "Kubex 3D",
  "webDir": ".",
  "bundledWebRuntime": false,
  "android": {
    "buildOptions": {
      "release": {
        "keystorePath": "",
        "keystorePassword": "",
        "keyAlias": "",
        "keyPassword": ""
      }
    },
    "backgroundColor": "#000000",
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#000000",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    }
  },
  "server": {
    "url": "http://127.0.0.1:5173",
    "cleartext": true
  }
}
